{
  "name": "dsh-agy-cli",
  "version": "0.12.2",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "description": "Run the locally authenticated AGY CLI as a DSH model provider. Official-binary-only transport; tool execution, approvals and sandbox stay in DSH.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./mock": {
      "types": "./lib/provider/mock.d.ts",
      "default": "./lib/provider/mock.js"
    },
    "./client": "./dist/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "bin": {
    "dsh-agy-cli": "bin/dsh-agy-cli.js"
  },
  "files": [
    "dist/**/*.js",
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "bin/**/*.js",
    "bin/**/*.exe",
    "agents/**/*.md",
    "cordis.patch.yml"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Gaudi-XIX/dsh-agy-cli.git"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-primitives"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build:client": "node scripts/build-client.mjs",
    "build": "tsc -p tsconfig.json && npm run build:client",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node scripts/run-tests.mjs",
    "diagnose": "npm run build && node scripts/diagnose.mjs",
    "smoke:dsh": "node scripts/dsh-smoke.mjs",
    "smoke:dsh:self-contained": "npm run build && node scripts/dsh-smoke-self-contained.mjs",
    "smoke:dsh:tool-bridge": "npm run build && node scripts/dsh-tool-bridge-smoke.mjs",
    "smoke:dsh:permission-matrix": "node scripts/dsh-permission-matrix-smoke.mjs",
    "agy:protocol": "npm run build && node scripts/agy-protocol-experiment.mjs",
    "tool:protocol": "npm run build && node scripts/tool-protocol-experiment.mjs",
    "agy:tool-contract": "npm run build && node scripts/tool-prompt-contract-experiment.mjs",
    "benchmark": "npm run build && node scripts/benchmark.mjs",
    "quota:experiment": "npm run build && node scripts/quota-experiment.mjs",
    "image:experiment": "npm run build && node scripts/image-protocol-experiment.mjs",
    "verify": "npm run typecheck && npm test && npm pack --dry-run",
    "prepare": "npm run build",
    "build:windows-launcher": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/build-windows-launcher.ps1"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-attachment": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-brand": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-invariants": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-llm": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-settings": "^0.2.0-rc.2",
    "@deepseek-ai/dsh-timeout": "^0.2.0-rc.2",
    "@deepseek-ai/schemastery": "^3.18.4",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-attachment": ">=0.1.7-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-brand": ">=0.1.7-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-invariants": ">=0.1.7-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-llm": ">=0.1.7-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-timeout": ">=0.1.7-rc.2 <0.3.0-0"
  },
  "directories": {
    "doc": "docs",
    "lib": "lib",
    "test": "tests"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "agy",
    "antigravity",
    "provider",
    "cli"
  ],
  "author": "",
  "bugs": {
    "url": "https://github.com/Gaudi-XIX/dsh-agy-cli/issues"
  },
  "homepage": "https://github.com/Gaudi-XIX/dsh-agy-cli#readme"
}
